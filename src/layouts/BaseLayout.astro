---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
  publishedDate?: Date;
  category?: string;
}

const SITE_TITLE = 'Signal & Substrate';
const SITE_URL = 'https://signalsubstrate.github.io';
const SITE_SUBTITLE = 'Notes on AI safety, machine learning mechanics, and data engineering.';
const DEFAULT_DESCRIPTION =
  'Technical essays and interactive explainers on AI safety, machine learning mechanics, and resilient data engineering pipelines.';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  isHome = false,
  publishedDate,
  category,
} = Astro.props;

const baseOrigin = (Astro.site ?? new URL(SITE_URL)).toString().replace(/\/$/, '');
const canonicalUrl = new URL(Astro.url.pathname, `${baseOrigin}/`).toString();
const pageTitle = title
  ? `${title} — ${SITE_TITLE}`
  : `${SITE_TITLE} — AI Safety, ML & Data Engineering`;
const isArticle = Boolean(publishedDate);

const jsonLd = isArticle
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      url: canonicalUrl,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalUrl,
      },
      datePublished: publishedDate!.toISOString(),
      dateModified: publishedDate!.toISOString(),
      articleSection: category,
      inLanguage: 'en-US',
      author: {
        '@type': 'Organization',
        name: SITE_TITLE,
        url: `${baseOrigin}/`,
      },
      publisher: {
        '@type': 'Organization',
        name: SITE_TITLE,
        url: `${baseOrigin}/`,
      },
    }
  : isHome
    ? {
        '@context': 'https://schema.org',
        '@type': 'Blog',
        name: SITE_TITLE,
        description,
        url: `${baseOrigin}/`,
        inLanguage: 'en-US',
        publisher: {
          '@type': 'Organization',
          name: SITE_TITLE,
          url: `${baseOrigin}/`,
        },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        name: pageTitle,
        description,
        url: canonicalUrl,
        inLanguage: 'en-US',
        isPartOf: {
          '@type': 'WebSite',
          name: SITE_TITLE,
          url: `${baseOrigin}/`,
        },
      };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />
    <meta name="author" content={SITE_TITLE} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {
      publishedDate && (
        <meta property="article:published_time" content={publishedDate.toISOString()} />
      )
    }
    {category && <meta property="article:section" content={category} />}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href="/rss.xml"
    />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <header class="site-banner">
      <div class="container">
        {
          isHome ? (
            <h1 class="banner-title">{SITE_TITLE}</h1>
          ) : (
            <p class="banner-title">{SITE_TITLE}</p>
          )
        }
        <p class="banner-subtitle">{SITE_SUBTITLE}</p>
      </div>
    </header>

    <main class="site-main">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-inner mono">
          <div class="footer-links">
            <a href="/about">About</a>
            <span class="sep" aria-hidden="true">/</span>
            <a href="/rss.xml">RSS</a>
          </div>
          <span class="footer-colophon">{SITE_TITLE}</span>
        </div>
      </div>
    </footer>

    <button
      type="button"
      id="back-to-top"
      class="back-to-top mono"
      aria-label="Back to top"
      aria-hidden="true"
      tabindex="-1"
    >
      ↑ Top
    </button>

    <script>
      const backToTopBtn = document.getElementById('back-to-top');
      if (backToTopBtn instanceof HTMLButtonElement) {
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const toggleVisibility = () => {
          const visible = window.scrollY > 240;
          backToTopBtn.classList.toggle('is-visible', visible);
          backToTopBtn.setAttribute('aria-hidden', visible ? 'false' : 'true');
          backToTopBtn.tabIndex = visible ? 0 : -1;
        };

        window.addEventListener('scroll', toggleVisibility, { passive: true });
        toggleVisibility();

        backToTopBtn.addEventListener('click', () => {
          window.scrollTo({
            top: 0,
            behavior: reducedMotion.matches ? 'auto' : 'smooth',
          });
        });
      }
    </script>
  </body>
</html>

<style>
  .site-banner {
    background-color: var(--bg-banner);
    color: var(--text-banner);
    padding: 1.5rem 0 1.625rem;
    border-bottom: 1px solid #352419;
  }

  .banner-title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: #f4ede4;
  }

  .banner-subtitle {
    margin: 0.3rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--text-banner-muted);
  }

  .site-main {
    flex: 1 0 auto;
    padding: 2.75rem 0 4rem;
  }

  .site-footer {
    flex-shrink: 0;
    padding-bottom: 2.5rem;
  }

  .footer-inner {
    border-top: 1px solid var(--border-hairline);
    padding-top: 1.375rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    font-size: var(--text-meta);
    color: var(--text-tertiary);
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .footer-links a {
    color: var(--text-secondary);
  }

  .footer-links a:hover {
    color: var(--accent-link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .sep {
    color: var(--border-muted);
  }

  .footer-colophon {
    color: var(--text-tertiary);
  }

  .back-to-top {
    position: fixed;
    right: max(1.25rem, calc(50% - 390px - 6.5rem));
    bottom: 1.5rem;
    z-index: 40;
    min-height: 40px;
    padding: 0.45rem 0.85rem;
    font-size: var(--text-meta);
    line-height: 1;
    color: var(--text-secondary);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-muted);
    border-radius: 3px;
    cursor: pointer;
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
    transition:
      opacity 160ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 160ms cubic-bezier(0.16, 1, 0.3, 1),
      color 140ms ease,
      border-color 140ms ease;
  }

  .back-to-top.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .back-to-top:hover {
    color: var(--accent-link);
    border-color: var(--accent-link);
  }

  @media (max-width: 600px) {
    .site-banner {
      padding: 1.25rem 0 1.375rem;
    }

    .site-main {
      padding: 2.125rem 0 3rem;
    }

    .back-to-top {
      right: 1rem;
      bottom: 1rem;
      min-height: 44px;
    }
  }
</style>
