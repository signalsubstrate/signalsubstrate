---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => !post.data.externalUrl)
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date): string {
  return date.toISOString().slice(0, 10);
}
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  publishedDate={post.data.date}
  category={post.data.category}
>
  <article class="article">
    <nav class="back-nav mono" aria-label="Return to index">
      <a href="/" class="back-link">← Index</a>
    </nav>

    <header class="article-header">
      <div class="article-meta mono">
        <time datetime={formatDate(post.data.date)}>
          {formatDate(post.data.date)}
        </time>
        <span class="meta-sep" aria-hidden="true">·</span>
        <span>{post.data.category}</span>
      </div>
      <h1 class="article-title">{post.data.title}</h1>
      <p class="article-lead">{post.data.description}</p>
    </header>

    <div class="prose article-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .back-nav {
    margin-bottom: 1.75rem;
    font-size: var(--text-meta);
  }

  .back-link {
    color: var(--text-secondary);
    display: inline-block;
    padding: 0.25rem 0;
  }

  .back-link:hover {
    color: var(--accent-link);
  }

  .article-header {
    padding-bottom: 1.75rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-hairline);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--text-meta);
    color: var(--text-secondary);
    margin-bottom: 0.625rem;
  }

  .meta-sep {
    color: var(--border-muted);
  }

  .article-title {
    margin: 0;
    font-size: var(--text-article-title);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    text-wrap: balance;
  }

  .article-lead {
    margin: 0.75rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .article-body {
    padding-bottom: 1rem;
  }
</style>
