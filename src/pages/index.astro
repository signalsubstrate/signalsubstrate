---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

function formatDate(date: Date): string {
  return date.toISOString().slice(0, 10);
}
---

<BaseLayout isHome={true}>
  <section aria-label="Published articles">
    <ul class="post-list">
      {
        posts.map((post) => {
          const href = post.data.externalUrl ?? `/blog/${post.id}`;
          return (
            <li class="post-item">
              <div class="post-meta mono">
                <time datetime={formatDate(post.data.date)}>
                  {formatDate(post.data.date)}
                </time>
                <span class="meta-sep" aria-hidden="true">·</span>
                <span class="post-category">{post.data.category}</span>
                {post.data.interactive && (
                  <>
                    <span class="meta-sep" aria-hidden="true">·</span>
                    <span class="post-interactive">[interactive]</span>
                  </>
                )}
              </div>
              <h2 class="post-title">
                <a href={href} class="post-link">
                  {post.data.title}
                </a>
              </h2>
              <p class="post-description">{post.data.description}</p>
            </li>
          );
        })
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-item {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border-hairline);
  }

  .post-item:first-child {
    padding-top: 0;
  }

  .post-item:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--text-meta);
    line-height: 1.4;
    color: var(--text-tertiary);
    margin-bottom: 0.35rem;
  }

  .post-meta time {
    color: var(--text-secondary);
  }

  .meta-sep {
    color: var(--border-muted);
  }

  .post-category {
    color: var(--text-tertiary);
  }

  .post-interactive {
    color: var(--accent-safe);
  }

  .post-title {
    margin: 0;
    font-size: var(--text-index-title);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.012em;
    text-wrap: balance;
  }

  .post-link {
    color: var(--text-primary);
    display: inline-block;
  }

  .post-link:hover {
    color: var(--accent-link);
  }

  .post-description {
    margin: 0.4rem 0 0;
    font-size: 0.96875rem;
    line-height: 1.6;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
